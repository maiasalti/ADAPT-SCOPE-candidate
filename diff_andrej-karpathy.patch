diff --git a/src/services/claimWithdrawal.ts b/src/services/claimWithdrawal.ts
new file mode 100644
index 0000000..306d23a
--- /dev/null
+++ b/src/services/claimWithdrawal.ts
@@ -0,0 +1,26 @@
+import { getClaimById, setClaimStatus } from './policyDb';
+
+export type WithdrawClaimResult =
+  | { ok: true; claim: { id: string; status: string } }
+  | { ok: false; httpStatus: 404 | 409; error: string };
+
+export function withdrawClaim(claimId: string): WithdrawClaimResult {
+  const claim = getClaimById(claimId);
+
+  if (!claim) {
+    return { ok: false, httpStatus: 404, error: `Claim not found: ${claimId}` };
+  }
+
+  if (claim.status !== 'submitted') {
+    return {
+      ok: false,
+      httpStatus: 409,
+      error: `Claim ${claimId} cannot be withdrawn from status '${claim.status}'`,
+    };
+  }
+
+  setClaimStatus(claimId, 'withdrawn');
+  console.log(`Claim withdrawn (audit): claimId=${claimId}`);
+
+  return { ok: true, claim: { id: claimId, status: 'withdrawn' } };
+}
diff --git a/src/services/policyDb.ts b/src/services/policyDb.ts
index 336e014..525dfcb 100644
--- a/src/services/policyDb.ts
+++ b/src/services/policyDb.ts
@@ -9,3 +9,13 @@ export function updateClaimStatus(claimId: string, status: string) {
   const rows = query(`UPDATE claims SET status = '${status}' WHERE id = '${claimId}'`);
   return rows[0];
 }
+
+export function getClaimById(claimId: string) {
+  const rows = query('SELECT * FROM claims WHERE id = ?', [claimId]);
+  return rows[0];
+}
+
+export function setClaimStatus(claimId: string, status: string) {
+  const rows = query('UPDATE claims SET status = ? WHERE id = ?', [status, claimId]);
+  return rows[0];
+}
